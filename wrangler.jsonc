/**
 * my-apps-portal — Cloudflare Workers (@opennextjs/cloudflare)
 * https://developers.cloudflare.com/workers/framework-guides/web-apps/nextjs/
 *
 * Unlike the five static apps, this is a dynamic app with Server Actions / API Routes / next/og,
 * so it needs a Worker script (.open-next/worker.js).
 * nodejs_compat is required by OpenNext.
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-apps-portal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
